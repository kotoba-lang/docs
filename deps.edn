{:paths ["src" "resources"]
 :deps {io.github.kotoba-lang/transit
        ;; Advanced off 77e3ce7d, the last commit before the office wire moved
        ;; from Transit-tagged JSON to plain JSON. Staying there made the
        ;; round-trip test below pass without the projection ever being
        ;; exercised, while consumers depending on any library that pinned the
        ;; newer transit resolved to it regardless.
        {:git/url "https://github.com/kotoba-lang/transit.git"
         :git/sha "ab5d9d956e088d77d7f91357f36a4a0c6bdfcadc"}
        ;; The OPC vocabulary a .docx is made of — content types,
        ;; relationships, the package. It already knew what one was:
        ;; `package-kind` returns :docx for a `word/` prefix. Zero runtime
        ;; deps of its own.
        io.github.kotoba-lang/ooxml
        {:git/url "https://github.com/kotoba-lang/ooxml.git"
         :git/sha "d4132a077c1c3797d6300a6a8a6f9c6952e27021"}
        ;; A pure .cljc XML parser producing hiccup. Reading a .docx needs
        ;; one; writing did not.
        io.github.kotoba-lang/xml
        {:git/url "https://github.com/kotoba-lang/xml.git"
         :git/sha "2e467cba6c587e0bad9c5dd0cbd456e43a348470"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
